# ---------------------------------------------------------------------------
# Planning workspace — local only, never tracked
# ---------------------------------------------------------------------------
/Plan/

# Local sample footage used for manual end-to-end verification
/samples/

# Local developer-tooling state. These paths are named literally because an
# ignore rule has to match the real filename to work; they are not part of the
# project and nothing in the codebase depends on them.
/.claude/
/.cursor/
/.github/copilot-instructions.md

# ---------------------------------------------------------------------------
# Python / backend
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Runtime data: uploaded videos, rendered overlays, cached landmarks, SQLite db
/backend/data/
/backend/models/
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
.eslintcache

# ---------------------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Assistant instruction files, kept on disk but out of the repository (see the
# note at the top of this file about why these are named literally).
CLAUDE.md
AGENTS.md
