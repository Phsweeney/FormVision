# FormVision backend configuration
#
# Copy to `.env` and edit. Every value here has a working default in
# app/config.py — this file exists to document what is tunable, not because
# anything is required.
#
# All variables use the FORMVISION_ prefix.

# --- Application -------------------------------------------------------------
FORMVISION_ENVIRONMENT=development
FORMVISION_LOG_LEVEL=INFO

# --- HTTP --------------------------------------------------------------------
# JSON array. Must include the origin the frontend is served from.
FORMVISION_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Storage -----------------------------------------------------------------
# Uploads, overlays, cached landmarks, and the SQLite file all live under here.
# FORMVISION_DATA_DIR=./data
# FORMVISION_DATABASE_URL=sqlite:///./data/formvision.db

# --- Upload limits -----------------------------------------------------------
FORMVISION_MAX_UPLOAD_BYTES=209715200
FORMVISION_MAX_VIDEO_DURATION_S=60

# --- Pose estimation ---------------------------------------------------------
FORMVISION_POSE_ESTIMATOR=mediapipe
# Frames are downscaled to this longest side before inference. Lower is faster,
# higher is more accurate on small subjects. Landmarks are normalised so this
# does not affect the coordinate system.
FORMVISION_POSE_INFERENCE_WIDTH=640
FORMVISION_LANDMARK_VISIBILITY_THRESHOLD=0.5

# --- Rep detection -----------------------------------------------------------
# The gap between descent and ascent fractions is a hysteresis band: it stops a
# hip hovering near the threshold from registering dozens of reps.
FORMVISION_REP_DESCENT_FRACTION=0.60
FORMVISION_REP_ASCENT_FRACTION=0.25
FORMVISION_MIN_REP_RANGE=0.15
FORMVISION_MIN_REP_DURATION_S=0.40

# --- Squat depth standard ----------------------------------------------------
# Knee angle mapped to 0% and 100% depth respectively. Lower parallel_knee_angle
# for a stricter (powerlifting) standard, raise it for a general-fitness one.
FORMVISION_STANDING_KNEE_ANGLE_DEG=170
FORMVISION_PARALLEL_KNEE_ANGLE_DEG=90
FORMVISION_GOOD_DEPTH_PERCENT=90
FORMVISION_SHALLOW_DEPTH_PERCENT=70

# --- Coaching rule sensitivity ----------------------------------------------
FORMVISION_MAX_TORSO_LEAN_DEG=45
FORMVISION_MAX_KNEE_ASYMMETRY_DEG=12
FORMVISION_MAX_DEPTH_VARIATION_PERCENT=12
FORMVISION_MAX_DURATION_VARIATION_S=0.75
FORMVISION_MIN_REP_TEMPO_S=1.2

# --- Machine learning --------------------------------------------------------
# Applies to uploaded videos only. The browser live mode is rule-based and does
# not consult a model.
#
# On by default because these detectors fail quiet rather than wrong: a sweep of
# 348 rep-level predictions across clean clips produced no firings at all. The
# asymmetry detector is verified to discriminate on FormVision's own pose data;
# valgus and heel lift are unproven against real footage and simply stay silent
# until they are. Set to false to return to pure V1/V2 behaviour. See docs/ml.md.
#
# Note what is not configurable here: the per-fault probability thresholds. They
# are chosen by cross-validation against particular fitted weights and travel
# inside the artifact. The knobs below are policy and can only make the model
# quieter than its own thresholds, never louder.
FORMVISION_ML_ENABLED=true
FORMVISION_ML_PREDICTOR=sklearn
# Share of a detector's inputs that must have been measured before it may speak.
FORMVISION_ML_MIN_FEATURE_COMPLETENESS=0.75
# Share of a rep's frames that must clear the model's threshold for the rep to
# count as showing the fault.
FORMVISION_ML_MIN_AFFECTED_FRACTION=0.25
# Share of judged reps that must show a fault before it is worth mentioning,
# rounded up, never less than one rep. Proportional rather than a fixed count:
# one flagged rep in ten is probably noise, one in two is half the evidence.
FORMVISION_ML_MIN_AFFECTED_REP_FRACTION=0.34
